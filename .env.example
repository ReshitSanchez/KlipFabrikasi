# =====================================================================
#  GİZLİ ANAHTARLAR
#  Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#      cp .env.example .env
#      nano .env
#  .env dosyasını KİMSEYLE PAYLAŞMAYIN ve GitHub'a yüklemeyin.
#  Boş bırakılan platformlar otomatik olarak kapalı sayılır.
# =====================================================================

# --- Twitch (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Kick (https://kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- YouTube canlı yayın arama için API anahtarı ---
# (Yükleme yapan kanal projelerinden AYRI bir Google Cloud projesinde oluşturun,
#  böylece arama, yükleme kotasını yemez.)
YOUTUBE_API_KEY=

# --- Groq (https://console.groq.com/keys) : Whisper yazıya dökme ---
GROQ_API_KEY=

# --- LLM (puanlama / çeviri / başlık) ---
# Groq kullanıyorsanız GROQ_API_KEY ile aynı değeri yazabilirsiniz.
LLM_API_KEY=

# --- Telegram botu (@BotFather'dan alınır) ---
TELEGRAM_BOT_TOKEN=
